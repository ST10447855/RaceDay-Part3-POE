@model EventVm

<div class="card rd-card h-100">
    @if (!string.IsNullOrWhiteSpace(Model.BannerImageURL))
    {
        <img src="@Model.BannerImageURL" class="rd-card-img" alt="@Model.Name banner" />
    }
    else
    {
        <div class="rd-card-img rd-card-img-placeholder"><span>@Model.EventTypeName</span></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <h5 class="card-title mb-0">@Model.Name</h5>
            <span class="badge rd-type-badge">@Model.EventTypeName</span>
        </div>
        <p class="text-muted small mb-2">@Model.Location &middot; @Model.Distance.ToString("0.##") km</p>
        <p class="card-text flex-grow-1">@Model.Description</p>
        <p class="rd-date mb-3">@Model.EventDate.ToString("ddd, dd MMM yyyy HH:mm")</p>
        <a class="btn btn-rd w-100 mt-auto" asp-controller="RaceEvents" asp-action="Details" asp-route-id="@Model.EventID">View details</a>
    </div>
</div>
