@model List<EventVm>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Manage events</h1>
    <a class="btn btn-rd" asp-action="CreateEvent">+ New event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No events yet. Create your first event.</div>
}
else
{
    <div class="rd-panel p-0 table-responsive">
        <table class="table rd-table align-middle mb-0">
            <thead><tr><th>Banner</th><th>Event</th><th>Date</th><th>Distance</th><th>Type</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var e in Model.OrderBy(x => x.EventDate))
            {
                <tr>
                    <td style="width:90px">
                        @if (!string.IsNullOrWhiteSpace(e.BannerImageURL))
                        {
                            <img src="@e.BannerImageURL" alt="" class="rd-thumb" />
                        }
                        else
                        {
                            <div class="rd-thumb rd-card-img-placeholder"></div>
                        }
                    </td>
                    <td><strong>@e.Name</strong><div class="small text-muted">@e.Location</div></td>
                    <td>@e.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@e.Distance.ToString("0.##") km</td>
                    <td>@e.EventTypeName</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditEvent" asp-route-id="@e.EventID">Edit</a>
                        <form asp-action="DeleteEvent" asp-route-id="@e.EventID" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this event?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
