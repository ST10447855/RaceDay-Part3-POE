@model EventFormVm
@{
    var isNew = Model.EventID == 0;
    ViewData["Title"] = isNew ? "Create Event" : "Edit Event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rd-panel p-4">
            <h1>@(isNew ? "Create event" : "Edit event")</h1>

            <form asp-action="@(isNew ? "CreateEvent" : "EditEvent")" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="EventID" />
                <input type="hidden" asp-for="BannerImageURL" />

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label">Date and time</label>
                        <input asp-for="EventDate" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label">Distance (km)</label>
                        <input asp-for="Distance" class="form-control" type="number" step="0.1" min="0.1" />
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventTypeID" class="form-label">Event type</label>
                        <select asp-for="EventTypeID" class="form-select">
                            <option value="0">Choose a type...</option>
                            @foreach (var t in Model.EventTypes)
                            {
                                <option value="@t.EventTypeID" selected="@(Model.EventTypeID == t.EventTypeID)">@t.TypeName</option>
                            }
                        </select>
                        <span asp-validation-for="EventTypeID" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label for="Banner" class="form-label">Banner image</label>
                        @if (!string.IsNullOrWhiteSpace(Model.BannerImageURL))
                        {
                            <div class="mb-2"><img src="@Model.BannerImageURL" alt="Current banner" class="rd-thumb-lg" /></div>
                        }
                        <input type="file" id="Banner" name="Banner" class="form-control" accept="image/*" />
                        <div class="form-text">jpg, png, gif or webp, up to 5 MB. Leave empty to keep the current banner.</div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-rd">@(isNew ? "Create event" : "Save changes")</button>
                    <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
